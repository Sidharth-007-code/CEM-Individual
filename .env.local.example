# Campus Marketplace - Environment Configuration Example
# Copy this file to .env.local and update with your real or local credentials.

# --- Client-side Firebase Configuration (Accessible to browser) ---
NEXT_PUBLIC_FIREBASE_API_KEY="demo-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="campus-marketplace-dev.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="campus-marketplace-dev"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="campus-marketplace-dev.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="1234567890"
NEXT_PUBLIC_FIREBASE_APP_ID="1:1234567890:web:abcdef123456"

# Toggle to true for developing against local Firebase Emulators (Auth on 9099, Firestore on 8080)
NEXT_PUBLIC_USE_FIREBASE_EMULATOR="true"
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL="http://127.0.0.1:9099"
NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST="127.0.0.1"
NEXT_PUBLIC_FIRESTORE_EMULATOR_PORT="8080"

# --- Server-only Configuration (NEVER prefix with NEXT_PUBLIC_) ---
# Allowed student email domain for registration
ALLOWED_EMAIL_DOMAIN="msruas.ac.in"

# OTP Security & Rate Limiting
OTP_HMAC_SECRET="change-this-to-a-secure-random-64-char-string"
# Development helper: prints OTP code to terminal in development if SMTP is not configured
OTP_DEV_ECHO="true"

# Gmail SMTP Configuration for Real OTP Delivery
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="your-university-bot@gmail.com"
SMTP_PASS="your-16-char-google-app-password"
MAIL_FROM_NAME="MSRUAS Campus Marketplace"

# Firebase Admin SDK Credentials (For server-side OTP verification and user provisioning)
FIREBASE_PROJECT_ID="campus-marketplace-dev"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@campus-marketplace-dev.iam.gserviceaccount.com"
# Note: In production, supply the private key with escaped newlines (\n)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQD...\n-----END PRIVATE KEY-----\n"

