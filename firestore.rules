rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActiveUser() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().status == 'active';
    }

    function hasRole(role) {
      return isActiveUser() && getUserData().role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isVerifier() {
      return hasRole('verifier') || isAdmin();
    }

    // OTP Requests: Client access completely denied! Admin SDK only.
    match /otpRequests/{hash} {
      allow read, write: if false;
    }

    // Users
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Only admin or user creation via Admin SDK.
      // If user updates their own profile, forbid role or status changes:
      allow update: if (isOwner(userId) &&
                        (!('role' in request.resource.data) || request.resource.data.role == resource.data.role) &&
                        (!('status' in request.resource.data) || request.resource.data.status == resource.data.status))
                    || isAdmin();
      allow create: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Listings
    match /listings/{listingId} {
      // Available listings visible to all authenticated users.
      // Draft, pending, rejected, hidden visible only to seller, verifier, or admin.
      allow read: if isAuthenticated() && (
        resource.data.status == 'available' ||
        resource.data.sellerId == request.auth.uid ||
        isVerifier()
      );

      allow create: if isActiveUser() &&
        request.resource.data.sellerId == request.auth.uid &&
        request.resource.data.price > 0 &&
        (request.resource.data.status == 'pending' || request.resource.data.status == 'draft');

      allow update: if isActiveUser() && (
        // Seller updating draft/pending listing
        (resource.data.sellerId == request.auth.uid &&
          (resource.data.status == 'draft' || resource.data.status == 'pending' || resource.data.status == 'needs_changes') &&
          (!('status' in request.resource.data) || request.resource.data.status == 'pending' || request.resource.data.status == 'draft'))
        ||
        // Verifier approving, rejecting, or requesting changes
        (isVerifier() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'verifierId', 'verifierNote', 'updatedAt']))
        ||
        // Report count increment
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportCount', 'status']) &&
          request.resource.data.reportCount == resource.data.reportCount + 1)
        ||
        // Order purchase: buyer marks listing as 'sold' atomically when creating order
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) &&
          resource.data.status == 'available' &&
          request.resource.data.status == 'sold')
        ||
        isAdmin()
      );

      allow delete: if isAdmin() || (isOwner(resource.data.sellerId) && resource.data.status == 'draft');

      match /images/{imgId} {
        allow read: if isAuthenticated();
        allow write: if isActiveUser() && (
          get(/databases/$(database)/documents/listings/$(listingId)).data.sellerId == request.auth.uid ||
          isAdmin()
        );
      }
    }

    // Wishlists
    match /wishlists/{userId}/items/{listingId} {
      allow read, write: if isOwner(userId) && isActiveUser();
    }

    // Conversations & Messages
    match /conversations/{convId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participantIds;
      allow create: if isActiveUser() && request.auth.uid in request.resource.data.participantIds;
      allow update: if isActiveUser() && request.auth.uid in resource.data.participantIds;

      match /messages/{messageId} {
        allow read: if isAuthenticated() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds;
        allow create: if isActiveUser() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds &&
          request.resource.data.senderId == request.auth.uid;
      }
    }

    // Orders
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        isAdmin()
      );

      // Rule enforcing transactional listing sale:
      // Buyer cannot be seller; listing must be 'available' prior to tx and marked 'sold' after tx!
      allow create: if isActiveUser() &&
        request.resource.data.buyerId == request.auth.uid &&
        request.resource.data.buyerId != request.resource.data.sellerId &&
        get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.status == 'available' &&
        getAfter(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.status == 'sold';

      allow update: if isActiveUser() && (
        (request.auth.uid == resource.data.buyerId || request.auth.uid == resource.data.sellerId) ||
        isAdmin()
      );

      match /tracking/{trackId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/orders/$(orderId)).data.buyerId == request.auth.uid ||
          get(/databases/$(database)/documents/orders/$(orderId)).data.sellerId == request.auth.uid ||
          isAdmin()
        );
        allow create: if isActiveUser() && (
          get(/databases/$(database)/documents/orders/$(orderId)).data.buyerId == request.auth.uid ||
          get(/databases/$(database)/documents/orders/$(orderId)).data.sellerId == request.auth.uid ||
          isAdmin()
        );
      }
    }

    // Returns
    match /returns/{returnId} {
      allow read: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isActiveUser() && request.resource.data.buyerId == request.auth.uid;
      allow update: if isActiveUser() && (
        request.auth.uid == resource.data.buyerId ||
        isAdmin()
      );
    }

    // Reports (listingId_userId ensures one report per user per listing)
    match /reports/{reportId} {
      allow read: if isAuthenticated() && (
        resource.data.reporterId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isActiveUser() &&
        request.resource.data.reporterId == request.auth.uid &&
        reportId == request.resource.data.listingId + '_' + request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Notifications
    match /notifications/{userId}/items/{notifId} {
      allow read, update, delete: if isOwner(userId);
      allow create: if isAuthenticated();
    }

    // Audit Log: only read and created by admin or server
    match /auditLog/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Constants: public read, admin write
    match /constants/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}

